<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="style.css">
        <title>URL Shortener</title>
    </head>

    <body>
        <%- include('./partials/header') %>

        <!-- Lec-71 
        <% if(locals.isLoggedIn){ %>
            <h2>You are Logged-in.</h2>
        <% } else { %>
            <h2>You are Not Logged-in.</h2>
        <% } %>  
        -->

        <main class="main">
            <section class="url-shortener container">
                <div class="user-status">
                    <!-- Lec-81 :- protected route -->
                    <% if(user){ %>
                    <div class="status-badge success">
                        <i class="zmdi zmdi-check-circle"></i> You are Logged-in.
                    </div>
                    <% } else { %>
                    <div class="status-badge warning">
                        <i class="zmdi zmdi-alert-triangle"></i> You are Not Logged-in.
                    </div>
                    <% } %>
                </div>

                <div class="shortener-content">
                    <div class="shortener-form">
                        <h2 class="form-title">URL Shortener</h2>
                        <form action="/" method="post" class="url-form">
                            <div class="form-group">
                                <input type="url" id="url" name="url" placeholder="Enter URL" required>
                                <label for="url"><i class="zmdi zmdi-link"></i></label>
                            </div>

                            <div class="form-group">
                                <input type="text" id="shortCode" name="shortCode" placeholder="Enter shortCode"
                                    required>
                                <label for="shortCode"><i class="zmdi zmdi-format-short-text"></i></label>
                            </div>

                            <!-- Lec-87 (Button ni Upper aa code aavvo joiye...) -->
                            <% if(locals.errors && locals.errors.length > 0) { %>
                                <% locals.errors.forEach(function(error) { %>
                                <p class="flash-error">
                                    <%= error %>
                                </p>
                                <% }); %>
                            <% } %>

                             <button type="submit" name="shorten" id="shorten" class="form-submit">Shorten</button>
                        </form>

                        <div class="shortened-urls">
                            <h3 class="section-title">Shortened URLs</h3>
                            <ul class="url-list">
                                <!-- Lec-17 -->
                                <% if(links && links.length > 0) { %>
                                    <ul class="url-list">
                                        <% links.map(({shortCode, url, id})=> { %>
                                            <% const truncatedUrl = url.length >= 40 ? `${url.slice(0,30)}...` : url %>
                                                <li class="url-item">
                                                    <div class="url-info">
                                                        <a href="/<%= shortCode %>" class="short-url" target="_blank">
                                                            <i class="zmdi zmdi-link"></i>
                                                            <%= host %>/<%= shortCode %>
                                                        </a>
                                                        <span class="original-url">
                                                            <%= truncatedUrl %>
                                                        </span>
                                                    </div>
                                                    <!-- Lec-87 :- ZOD Validation in URLs and Shortcodes -->
                                                    <div class="url-actions">
                                                        <button class="copy-btn"
                                                            data-url="<%= host %>/<%= shortCode %>">
                                                            <i class="zmdi zmdi-copy"></i>
                                                        </button>

                                                        <button class="copy-btn edit-btn">
                                                            <a href="/edit/<%= id %>">
                                                                <i class="zmdi zmdi-edit"></i>
                                                            </a>
                                                        </button>

                                                        <form action="/delete/<%= id %>" method="post">
                                                            <button class="copy-btn delete-btn">
                                                                <i class="zmdi zmdi-delete"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                </li>
                                        <% }) %>
                                    </ul>
                                <% } else { %>
                                    <p class="empty-list">
                                        No shortened URLs yet. Create your first one above!
                                    </p>
                                <% } %>
                            </ul>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        <!-- Lec-124 :- Pagination component -->
        <% if (totalPages> 1) { %>
            <div class="pagination">
                <!-- Previous page link -->
                <% if (currentPage> 1) { %>
                    <a href="?page=<%= currentPage - 1 %>" class="page-link">&laquo; Previous</a>
                <% } else { %>
                    <span class="page-link disabled">&laquo; Previous</span>
                <% } %>


                <!-- Page numbers :- if my current page=5 :- 3 4 |5| 6 7  -->
                <% 
                // Calculate the range of page numbers to display 
                let startPage = Math.max(1, currentPage - 2); // 3 
                let endPage = Math.min(totalPages, currentPage + 2); // 7 
                                
                // Ensure 5 pages are shown if possible 
                while (endPage - startPage < 4 && startPage > 1) {
                    startPage--;
                }
                while (endPage - startPage < 4 && endPage < totalPages) { 
                    endPage++; 
                } 
                %>

                <!-- Always show first page   if(3>1) -->
                <% if (startPage> 1) { %>
                    <a href="?page=1" class="page-link">1</a>
                    <% if (startPage> 2) { %>
                        <span class="ellipsis">...</span>
                    <% } %>
                <% } %>

                <!-- Show page numbers around current page -->
                <% for (let i=startPage; i <=endPage; i++) { %>
                    <% if (i===currentPage) { %>
                        <span class="page-link current">
                            <%= i %>
                        </span>
                    <% } else { %>
                        <a href="?page=<%= i %>" class="page-link">
                            <%= i %>
                        </a>
                    <% } %>
                <% } %>

                <!-- Always show last page    if(7<10) & if(7<10-1) -->
                <% if (endPage < totalPages) { %>
                    <% if (endPage < totalPages - 1) { %>
                        <span class="ellipsis">...</span>
                    <% } %>
                    <a href="?page=<%= totalPages %>" class="page-link">
                        <%= totalPages %>
                    </a>
                <% } %>


                <!-- Next page link -->
                <% if (currentPage < totalPages){ %>
                    <a href="?page=<%= currentPage + 1 %>" class="page-link">Next &raquo;</a>
                <% } else { %>
                        <span class="page-link disabled">Next &raquo;</span>
                <% } %>

            </div>
        <% } %>

        <%- include('./partials/footer') %>

        <script>
            // Simple copy to clipboard functionality
            document.addEventListener("DOMContentLoaded", function () {
                const copyButtons = document.querySelectorAll(".copy-btn");

                copyButtons.forEach((button) => {
                    button.addEventListener("click", function () {
                        const url = this.getAttribute("data-url");
                        navigator.clipboard.writeText(url).then(() => {
                            // Visual feedback
                            this.innerHTML = '<i class="zmdi zmdi-check"></i>';
                            setTimeout(() => {
                                this.innerHTML = '<i class="zmdi zmdi-copy"></i>';
                            }, 2000);
                        });
                    });
                });
            });
        </script>
    </body>
</html>